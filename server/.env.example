# Nome DNS o IP pubblico del server (usato anche come "realm" di coturn)
PUBLIC_HOST=remoto.example.com

# Segreto condiviso tra server ID e coturn per le credenziali TURN temporanee.
# Generane uno lungo e casuale, ad esempio:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TURN_SECRET=cambia-questo-segreto

# 1 se il server ID sta dietro un reverse proxy (Caddy, nginx) che imposta X-Forwarded-For
TRUST_PROXY=0
